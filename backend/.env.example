APP_NAME=HospitalityPlatform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hospitality
DB_USERNAME=hospitality
DB_PASSWORD=hospitality

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_COOKIE=hospitality_session
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8080,127.0.0.1,127.0.0.1:5173,127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

VITE_API_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8080


# Albanian fiscalization (references only; do not commit certificate/password material)
FISCAL_SECRET_DIR=/run/secrets
FISCAL_DPT_CA_BUNDLE=
FISCAL_VERIFY_URL_TEST=
